{
  "name": "@latido/engine",
  "version": "0.2.2",
  "private": true,
  "description": "Motor de Latido: conectores, normalización, clustering y Trend Engine. TypeScript puro, sin I/O implícito.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "default": "./dist/sources/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
